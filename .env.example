# ── Required ───────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional: switch model ──────────────────────────────────
# OPENAI_MODEL=gpt-4o-mini   # cheaper; good for most tasks

# ── Optional: LangSmith tracing ────────────────────────────
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__...
# LANGCHAIN_PROJECT=marketing-agent

# ── Twitter / X ─────────────────────────────────────────────
# Get these from: https://developer.twitter.com/en/portal
# TWITTER_API_KEY=...
# TWITTER_API_SECRET=...
# TWITTER_ACCESS_TOKEN=...
# TWITTER_ACCESS_SECRET=...

# ── LinkedIn ─────────────────────────────────────────────────
# OAuth 2.0 token from: https://developer.linkedin.com
# LINKEDIN_ACCESS_TOKEN=...
# Your LinkedIn member ID (call GET /v2/me to find it)
# LINKEDIN_PERSON_ID=urn:li:person:XXXXXXX

# ── Buffer (posts to Twitter, LinkedIn, Instagram, Facebook) ─
# Get token from: https://buffer.com/developers/api
# BUFFER_ACCESS_TOKEN=...
